{
  "name": "hmi-lab-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HMI Research Group website — Astro static site with structured research content",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "sync": "astro sync",
    "check": "astro check",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:content": "vitest run tests/content",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "build": "npm run build:staging",
    "build:staging": "PUBLIC_SITE_URL=https://hmi-iiitd.github.io PUBLIC_BASE_PATH=/hmi-lab-website/ astro build",
    "build:production": "PUBLIC_SITE_URL=https://hmi.iiitd.edu.in PUBLIC_BASE_PATH=/ astro build",
    "preview": "astro preview --port 4321",
    "preview:staging": "npm run build:staging && astro preview --port 4321",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run validate:content && npm run build:staging"
  },
  "dependencies": {
    "astro": "^5.7.10",
    "gray-matter": "^4.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.14.0",
    "axe-core": "^4.10.3",
    "eslint": "^9.24.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vitest": "^3.1.1"
  }
}
