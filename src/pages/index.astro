---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SelectedResearch from "../components/SelectedResearch.astro";
import ResearchThemes from "../components/ResearchThemes.astro";
import ApplicationPathways from "../components/ApplicationPathways.astro";
import CommunityPreview from "../components/CommunityPreview.astro";
import NewsHighlights from "../components/NewsHighlights.astro";
import { withBase } from "../lib/url";
import {
  HERO_INTRODUCTION,
  LAB_NAME,
  PRIMARY_THEME_IDS,
  PUNCHLINE,
  RESEARCH_IDENTITY,
} from "../lib/identity";

const themes: CollectionEntry<"research-areas">[] = (await getCollection("research-areas"))
  .filter((entry: CollectionEntry<"research-areas">) => entry.data.published)
  .sort(
    (a: CollectionEntry<"research-areas">, b: CollectionEntry<"research-areas">) =>
      a.data.order - b.data.order,
  );

const applicationTags: CollectionEntry<"application-tags">[] = (
  await getCollection("application-tags")
).filter((entry: CollectionEntry<"application-tags">) => entry.data.published);

const publications: CollectionEntry<"publications">[] = await getCollection("publications");
const news: CollectionEntry<"news">[] = await getCollection("news");

---

<BaseLayout
  title={`${LAB_NAME} · IIIT-Delhi`}
  description={`${LAB_NAME} at IIIT-Delhi — ${RESEARCH_IDENTITY}. ${PUNCHLINE}`}
>
  <section class="hero wrap" id="hero" aria-labelledby="hero-title">
    <svg
      class="hero-art"
      data-motion="decorative"
      viewBox="0 0 360 360"
      aria-hidden="true"
    >
      <g fill="none" stroke="#2b8579" stroke-width="1.4">
        <circle cx="180" cy="180" r="130"></circle>
        <circle cx="180" cy="180" r="96"></circle>
        <circle cx="180" cy="180" r="61"></circle>
        <path d="M40 180H320M180 38V322" stroke-dasharray="2 9"></path>
      </g>
      <g class="orb">
        <circle cx="180" cy="50" r="11" fill="#2b8579"></circle>
        <circle cx="276" cy="271" r="7" fill="#2b8579"></circle>
        <circle cx="85" cy="267" r="5" fill="#2b8579"></circle>
      </g>
      <g class="orb rev">
        <circle cx="180" cy="84" r="7" fill="#2b8579"></circle>
        <circle cx="104" cy="120" r="6" fill="#2b8579"></circle>
      </g>
      <circle cx="180" cy="180" r="11" fill="#2b8579"></circle>
    </svg>

    <div class="hero-copy">
      <p class="eyebrow">Interactive Intelligence · IIIT-Delhi</p>
      <h1 id="hero-title">Intelligence emerges <em>through interaction.</em></h1>
      <div class="hero-bottom">
        <p class="lead">{HERO_INTRODUCTION}</p>
        <div class="hero-actions">
          <a class="btn" href={withBase("research/")}>Explore research</a>
          <a class="btn btn-ghost" href={withBase("publications/")}>View publications</a>
          <a class="btn btn-ghost" href={withBase("about/")}>About the lab</a>
        </div>
      </div>
    </div>
  </section>

  <SelectedResearch publications={publications} />
  <ResearchThemes themes={themes.filter((t) => PRIMARY_THEME_IDS.includes(t.data.id as (typeof PRIMARY_THEME_IDS)[number]))} />
  <ApplicationPathways tags={applicationTags} />
  <CommunityPreview />
  <NewsHighlights items={news} />
</BaseLayout>
