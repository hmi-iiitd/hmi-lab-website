---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LAB_NAME } from "../../lib/identity";

const people: CollectionEntry<"people">[] = (await getCollection("people"))
  .filter((e: CollectionEntry<"people">) => e.data.published)
  .sort((a: CollectionEntry<"people">, b: CollectionEntry<"people">) => {
    const rank = (role: string) => (role === "director" || role === "faculty" ? 0 : 1);
    const byRole = rank(a.data.role) - rank(b.data.role);
    if (byRole !== 0) return byRole;
    return a.data.name.localeCompare(b.data.name);
  });

function titleLines(title: string | undefined, role: string): string[] {
  const raw = (title ?? role).trim();
  return raw
    .split(/\s*;\s*/)
    .map((line) => line.trim())
    .filter(Boolean);
}

function bioParagraphs(bio: string | undefined): string[] {
  if (!bio) return [];
  return bio
    .split(/\n\s*\n/)
    .map((p) => p.replace(/\s+/g, " ").trim())
    .filter(Boolean);
}

function emphasizeInteractiveIntelligence(text: string): Array<string | { em: string }> {
  const parts: Array<string | { em: string }> = [];
  const re = /interactive intelligence/gi;
  let last = 0;
  let match: RegExpExecArray | null;
  while ((match = re.exec(text)) !== null) {
    if (match.index > last) parts.push(text.slice(last, match.index));
    parts.push({ em: match[0] });
    last = match.index + match[0].length;
  }
  if (last < text.length) parts.push(text.slice(last));
  return parts;
}
---

<BaseLayout
  title={`People · ${LAB_NAME}`}
  description={`People of the ${LAB_NAME} at IIIT-Delhi.`}
>
  <section class="section wrap">
    <p class="section-label">People</p>
    <h1 class="section-title">Research is a collective effort</h1>
    <p class="muted">
      Verified public profiles for the HMI Research Group. Contact the lab at
      <a href="mailto:hmi@iiitd.ac.in">hmi@iiitd.ac.in</a>.
    </p>
    {
      people.length === 0 ? (
        <p class="muted" style="margin-top: 2rem;">
          No verified public profiles are listed at this time.
        </p>
      ) : (
        <div class="card-list" style="margin-top: 2rem;">
          {people.map((person) => (
            <article>
              <h2 style="font-family: var(--font-display); font-weight: 400; font-size: 1.5rem;">
                {person.data.name}
              </h2>
              {titleLines(person.data.title, person.data.role).map((line) => (
                <p class="muted">{line}</p>
              ))}
              {bioParagraphs(person.data.bio).map((para) => (
                <p>
                  {emphasizeInteractiveIntelligence(para).map((part) =>
                    typeof part === "string" ? part : <em>{part.em}</em>,
                  )}
                </p>
              ))}
              {person.data.website && (
                <p>
                  <a class="text-link" href={person.data.website} rel="noopener noreferrer">
                    Institutional profile <span aria-hidden="true">↗</span>
                  </a>
                </p>
              )}
            </article>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
