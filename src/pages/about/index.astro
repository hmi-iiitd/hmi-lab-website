---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  LAB_NAME,
  MINSKY_SOCIETY_OF_MIND,
  RESEARCH_IDENTITY,
  RESEARCH_PHILOSOPHY_LABEL,
  RESEARCH_PHILOSOPHY_PARAGRAPHS,
  RESEARCH_PHILOSOPHY_QUESTION,
} from "../../lib/identity";

const entry = await getEntry("identity", "approved-description");
if (!entry) {
  throw new Error("Missing canonical identity document: approved-description");
}
const { Content } = await render(entry);
---

<BaseLayout
  title={`About · ${LAB_NAME}`}
  description={`${LAB_NAME} at IIIT-Delhi studies ${RESEARCH_IDENTITY}: intelligence that emerges through interaction.`}
>
  <article class="section wrap about-page">
    <p class="section-label">About</p>
    <div class="about-prose" id="about-approved-description">
      <Content />
    </div>

    <section class="about-philosophy" aria-labelledby="research-philosophy-title">
      <p class="section-label">{RESEARCH_PHILOSOPHY_LABEL}</p>
      <h2 class="section-title" id="research-philosophy-title">{RESEARCH_PHILOSOPHY_QUESTION}</h2>
      <div class="about-prose about-philosophy-prose">
        {RESEARCH_PHILOSOPHY_PARAGRAPHS.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <figure class="about-quote">
      <blockquote>
        <p>{MINSKY_SOCIETY_OF_MIND.text}</p>
      </blockquote>
      <figcaption>
        — {MINSKY_SOCIETY_OF_MIND.author},
        <cite>{MINSKY_SOCIETY_OF_MIND.work}</cite>
        ({MINSKY_SOCIETY_OF_MIND.year}), §{MINSKY_SOCIETY_OF_MIND.section}, p.&nbsp;{MINSKY_SOCIETY_OF_MIND.page}.
      </figcaption>
    </figure>
  </article>
</BaseLayout>
