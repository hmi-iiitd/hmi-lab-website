---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ApplicationPathways from "../../components/ApplicationPathways.astro";
import { withBase } from "../../lib/url";
import {
  LAB_NAME,
  PRIMARY_THEME_IDS,
  RESEARCH_IDENTITY,
  RESEARCH_PAGE_THEMES_LEDE,
} from "../../lib/identity";
import {
  isPublicPublication,
  sortPubsNewestFirst,
  type PubEntry,
} from "../../lib/publications";

const themes: CollectionEntry<"research-areas">[] = (await getCollection("research-areas"))
  .filter((e: CollectionEntry<"research-areas">) => e.data.published)
  .sort(
    (a: CollectionEntry<"research-areas">, b: CollectionEntry<"research-areas">) =>
      a.data.order - b.data.order,
  );

const applicationTags: CollectionEntry<"application-tags">[] = (
  await getCollection("application-tags")
).filter((e: CollectionEntry<"application-tags">) => e.data.published);

const pubs: PubEntry[] = (await getCollection("publications"))
  .filter(isPublicPublication)
  .sort(sortPubsNewestFirst);

const projects: CollectionEntry<"projects">[] = (await getCollection("projects")).filter(
  (e: CollectionEntry<"projects">) => e.data.published,
);

function papersForTheme(themeId: string, limit = 3): PubEntry[] {
  return pubs
    .filter((p) => (p.data.research_areas ?? []).includes(themeId))
    .slice(0, limit);
}
---

<BaseLayout
  title={`Research · ${LAB_NAME}`}
  description={`${RESEARCH_IDENTITY} at ${LAB_NAME}: three scientific themes and cross-cutting application pathways.`}
>
  <section class="section wrap">
    <p class="section-label">Research</p>
    <h1 class="section-title">Themes under Interactive Intelligence</h1>
    <p class="muted research-lede">{RESEARCH_PAGE_THEMES_LEDE}</p>

    <div class="directions" id="research-themes" style="margin-top: 2rem;">
      {
        themes
          .filter((t) => PRIMARY_THEME_IDS.includes(t.data.id as (typeof PRIMARY_THEME_IDS)[number]))
          .map((theme, index) => {
            const papers = papersForTheme(theme.data.id);
            return (
              <article class="direction">
                <span class="direction-index">{String(index + 1).padStart(2, "0")}</span>
                <h2 class="direction-title">{theme.data.title}</h2>
                <p>{theme.data.summary}</p>
                {papers.length > 0 && (
                  <ul class="theme-paper-list">
                    {papers.map((pub) => (
                      <li>
                        <a href={withBase(`papers/${pub.data.slug}/`)}>{pub.data.title}</a>
                        <span class="muted">
                          {" "}
                          · {pub.data.venue_short || pub.data.venue_full} ({pub.data.publication_year})
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
                <p class="theme-index-actions">
                  <a class="text-link" href={withBase(`research/${theme.data.slug}/`)}>
                    View theme <span aria-hidden="true">↗</span>
                  </a>
                  <a class="text-link" href={withBase(`publications/?theme=${theme.data.id}`)}>
                    Publications in this theme <span aria-hidden="true">↗</span>
                  </a>
                </p>
              </article>
            );
          })
      }
    </div>
  </section>

  <ApplicationPathways tags={applicationTags} compact />

  <section class="section wrap" aria-labelledby="projects-title">
    <h2 class="section-title" id="projects-title" style="font-size: 1.6rem;">Projects</h2>
    {
      projects.length === 0 ? (
        <p class="muted" style="margin-top: 1rem;">
          No verified project pages yet. Unfinished project drafts remain unpublished.
          See the{" "}
          <a class="text-link" href={withBase("publications/")}>publications archive</a>{" "}
          for verified research records.
        </p>
      ) : (
        <ul class="theme-paper-list" style="margin-top: 1rem;">
          {projects.map((project) => (
            <li>
              <a href={withBase(`projects/${project.data.slug}/`)}>{project.data.title}</a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
