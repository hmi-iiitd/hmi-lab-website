---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/url";

const themes: CollectionEntry<"research-areas">[] = (await getCollection("research-areas"))
  .filter((e: CollectionEntry<"research-areas">) => e.data.published)
  .sort(
    (a: CollectionEntry<"research-areas">, b: CollectionEntry<"research-areas">) =>
      a.data.order - b.data.order,
  );

const projects: CollectionEntry<"projects">[] = (await getCollection("projects")).filter(
  (e: CollectionEntry<"projects">) => e.data.published,
);
---

<BaseLayout title="Research · HMI Lab">
  <section class="section wrap">
    <p class="section-label">Research</p>
    <h1 class="section-title">Themes and selected projects</h1>
    <p class="muted" style="max-width: 40rem; margin-top: 1rem;">
      Structured from the research-areas content collection. Flagship project pages arrive after
      bibliographic verification.
    </p>
    <div class="directions" style="margin-top: 2rem;">
      {
        themes.map((theme, index) => (
          <article class="direction">
            <span class="direction-index">{String(index + 1).padStart(2, "0")}</span>
            <h2 style="font: 400 1.45rem/1.25 var(--font-display); margin: 0 0 0.7rem;">
              {theme.data.title}
            </h2>
            <p>{theme.data.summary}</p>
          </article>
        ))
      }
    </div>
    {
      projects.length === 0 && (
        <p class="muted" style="margin-top: 2rem;">
          No published project pages yet.{" "}
          <a class="text-link" href={withBase("publications/")}>Publications index</a>
        </p>
      )
    }
  </section>
</BaseLayout>
