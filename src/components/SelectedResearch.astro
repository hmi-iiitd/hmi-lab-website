---
import type { CollectionEntry } from "astro:content";
import SectionHeader from "./SectionHeader.astro";
import { withBase } from "../lib/url";
import { selectedResearchPublications } from "../lib/publications";
import { getApprovedPlainLanguageTldr } from "../lib/plain-language-tldr";

interface Props {
  publications: CollectionEntry<"publications">[];
}

const { publications } = Astro.props;
const selected = selectedResearchPublications(publications);
const primary = selected[0];
// Option A: one primary feature + up to six compact cards (plus optional e2e fixture).
const secondary = selected.slice(1);
const primaryTldr = primary ? getApprovedPlainLanguageTldr(primary.data) : undefined;
const elevatedSlugs = new Set([
  "predictive-asd-acoustic-linguistic",
  "trial-pupil-dynamics-adhd",
]);

/** Selected Research status line — D9: suppress promotional award labels here. */
function statusLabel(pub: CollectionEntry<"publications">): string {
  const bits = [pub.data.venue_short ?? pub.data.kind, String(pub.data.publication_year)];
  if (pub.data.status === "accepted") bits.push("Accepted");
  return bits.join(" · ");
}
---

<section class="section wrap" id="selected-research" aria-labelledby="selected-title">
  <SectionHeader
    label="01 / Selected work"
    title="Ideas made tangible."
    intro="Seven verified Interactive Intelligence contributions—foundational multi-agent learning, neurodevelopment and clinical collaboration, human-centered robotics, immersive interaction, affective computing, and wearable sensing. Full records remain in the publications archive."
    titleId="selected-title"
  />

  {
    !primary ? (
      <p class="placeholder-banner">No verified featured publications are available yet</p>
    ) : (
      <>
        <article class="feature feature--text" aria-labelledby="feature-title">
          <div class="feature-body">
            <p class="feature-meta">{statusLabel(primary)}</p>
            <h3 class="feature-title" id="feature-title">{primary.data.title}</h3>
            <p class="feature-authors">
              {primary.data.authors.map((a: { name: string }) => a.name).join(", ")}
            </p>
            {primaryTldr && <p class="plain-language-tldr">{primaryTldr}</p>}
            <a class="text-link" href={withBase(`papers/${primary.data.slug}/`)}>
              Paper page <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        {
          secondary.length > 0 && (
            <div class="mini-grid">
              {secondary.map((pub) => {
                const tldr = getApprovedPlainLanguageTldr(pub.data);
                const elevated = elevatedSlugs.has(pub.data.slug);
                return (
                  <article class:list={["mini-card", { "mini-card--elevated": elevated }]}>
                    <p class="mini-meta">{statusLabel(pub)}</p>
                    <h3>
                      <a href={withBase(`papers/${pub.data.slug}/`)}>{pub.data.title}</a>
                    </h3>
                    <p class="mini-authors">
                      {pub.data.authors.map((a: { name: string }) => a.name).join(", ")}
                    </p>
                    {tldr && <p class="plain-language-tldr">{tldr}</p>}
                  </article>
                );
              })}
            </div>
          )
        }
      </>
    )
  }
</section>
