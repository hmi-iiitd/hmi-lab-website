---
import BrandLogo from "./BrandLogo.astro";
import { withBase } from "../lib/url";

const links = [
  { href: withBase("research/"), label: "Research" },
  { href: withBase("publications/"), label: "Publications" },
  { href: withBase("people/"), label: "People" },
  { href: withBase("about/"), label: "About" },
];
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header wrap">
  <a class="brand" href={withBase("/")}>
    <BrandLogo variant="header" decorative />
    <span class="brand-text">
      HMI
      <small>Research Group · IIIT-Delhi</small>
    </span>
  </a>
  <button
    type="button"
    class="nav-toggle"
    id="nav-toggle"
    aria-controls="site-nav"
    aria-expanded="false"
  >
    Menu
  </button>
  <nav class="nav" id="site-nav" aria-label="Main">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="btn" href="mailto:hmi@iiitd.ac.in">Contact</a>
  </nav>
</header>

<script>
  document.documentElement.classList.add("js");

  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("site-nav");

  function setOpen(open: boolean) {
    if (!toggle || !nav) return;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    nav.classList.toggle("is-open", open);
  }

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    setOpen(open);
    if (open) {
      nav?.querySelector("a")?.focus();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>
