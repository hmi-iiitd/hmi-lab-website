---
import type { CollectionEntry } from "astro:content";
import SectionHeader from "./SectionHeader.astro";

interface Props {
  items: CollectionEntry<"news">[];
}

const { items } = Astro.props;
const published = items.filter((item) => item.data.published);
---

{
  published.length > 0 && (
    <section class="section wrap" id="news-highlights" aria-labelledby="news-title">
      <SectionHeader
        label="05 / News & achievements"
        title="What the lab is building toward."
        intro="Dated, verified highlights from the HMI Research Group."
        titleId="news-title"
      />
      <div class="news-list">
        {published.map((item) => (
          <article class="news-item">
            <div class="date">{item.data.date}</div>
            <div>
              <h3>{item.data.title}</h3>
              <p class="muted">{item.data.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}
