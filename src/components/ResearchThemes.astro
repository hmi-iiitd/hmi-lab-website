---
import type { CollectionEntry } from "astro:content";
import SectionHeader from "./SectionHeader.astro";
import { HOMEPAGE_THEMES_INTRO } from "../lib/identity";
import { withBase } from "../lib/url";

interface Props {
  themes: CollectionEntry<"research-areas">[];
}

const { themes } = Astro.props;
---

<section class="section wrap" id="research-themes" aria-labelledby="themes-title">
  <SectionHeader
    label="02 / Research directions"
    title="Three themes of Interactive Intelligence."
    intro={HOMEPAGE_THEMES_INTRO}
    titleId="themes-title"
  />
  <div class="directions">
    {
      themes.map((theme, index) => (
        <article class="direction">
          <span class="direction-index">{String(index + 1).padStart(2, "0")}</span>
          <h3>{theme.data.title}</h3>
          <p>{theme.data.summary}</p>
          <a class="text-link" href={withBase(`research/${theme.data.slug}/`)}>
            View theme <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))
    }
  </div>
</section>
