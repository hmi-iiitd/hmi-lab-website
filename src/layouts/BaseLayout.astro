---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";
import "../styles/components.css";
import { isStagingBase, withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "HMI Research Group · IIIT-Delhi",
  description = "Human–Machine Interaction Research Group at IIIT-Delhi.",
  image = withBase("brand/og-image.png"),
} = Astro.props;

const staging = isStagingBase(import.meta.env.BASE_URL);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {staging && <meta name="robots" content="noindex,nofollow" />}
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("brand/favicon.ico")} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("brand/favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase("brand/favicon-16.png")} />
    <link rel="apple-touch-icon" href={withBase("brand/apple-touch-icon.png")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HMI Research Group" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="HMI Research Group — Human–Machine Interaction" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
