---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";
import { isStagingBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "HMI Research Group · IIIT-Delhi",
  description = "Human–Machine Interaction Research Group at IIIT-Delhi.",
} = Astro.props;

const staging = isStagingBase(import.meta.env.BASE_URL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {staging && <meta name="robots" content="noindex,nofollow" />}
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
